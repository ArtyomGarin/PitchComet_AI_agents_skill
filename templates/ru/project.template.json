    },
    {
      "path": "fin.revenue_last",
      "fmt": "money_mn0"
    },
    {
      "path": "fin.moic_base",
      "fmt": "x1"
    },
    {
      "path": "fin.irr_base",
      "fmt": "pct0"
    },
    {
      "path": "fin.ltv_cac_last",
      "fmt": "x1"
    },
    {
      "path": "score.total",
