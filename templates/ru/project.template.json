        "args": {
          "model_correct": 1880,
          "baseline_correct": 1640,
          "n": 2000
        }
      },
      {
        "id": "trl",
        "fn": "trl_assess",
        "args": {
          "evidence": {
            "trl1": true,
            "trl2": true,
            "trl3": true,
            "trl4": true,
            "trl5": true,
            "trl6": true,
            "trl7": false
